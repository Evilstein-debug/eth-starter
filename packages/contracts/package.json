{
  "name": "@starter/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "fmt": "forge fmt",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "deploy:sepolia": "forge script script/Deploy.s.sol --rpc-url ${SEPOLIA_RPC_URL:?set SEPOLIA_RPC_URL in packages/contracts/.env} --broadcast"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0"
  }
}
