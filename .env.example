# Root environment for repo scripts (pnpm seed, pnpm e2e:happy, pnpm dev).
# Copy to .env (gitignored). Local anvil needs NOTHING here.
# App settings live in apps/web/.env.example, apps/server/.env.example and
# packages/contracts/.env.example.

# Chain the scripts target. 31337 = local anvil, 11155111 = Ethereum Sepolia.
# (`pnpm dev` always forces 31337.)
CHAIN_ID=31337

# Optional RPC override for that chain. Unset → viem's default public RPC (see VERIFIED.md).
# Sepolia endpoints: https://chainlist.org/chain/11155111
RPC_URL=

# apps/server base URL (e2e:happy calls it and checks the activity feed).
SERVER_URL=http://localhost:8787

# Demo wallets for `pnpm seed` and `pnpm e2e:happy` (alice = payer, bob = payee).
# On local anvil leave these empty: anvil's public dev accounts #1-#3 are used.
# On a testnet: THROWAWAY keys only, generated just for this hackathon. Never reuse a key that
# holds or ever held real funds, and never commit .env.
#   Generate:  cast wallet new   (https://getfoundry.sh/cast/reference/wallet)
#   Gas:       fund each address with Sepolia ETH from a faucet
#              (list: https://ethereum.org/developers/docs/networks/#sepolia)
DEMO_ALICE_PRIVATE_KEY=
DEMO_BOB_PRIVATE_KEY=
DEMO_CAROL_PRIVATE_KEY=

# Test tokens each demo wallet is topped up to by `pnpm seed`.
SEED_TOKEN_AMOUNT=10000

# Local anvil only: your own browser wallet address(es), comma-separated. `pnpm dev`/`pnpm seed`
# give them 100 ETH + test tokens so you can click through the UI right away.
SEED_EXTRA_ADDRESSES=
